run-api.watsonzhu.cn {
	@privateApi {
		method POST
		path /api/v1/chat /api/v1/training/stats
	}
	handle @privateApi {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:18080
	}
	@conversation {
		method GET POST DELETE
		path_regexp conversation ^/api/v1/conversations(/[0-9a-f-]{36}(/turns)?)?$
	}
	handle @conversation {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:18080
	}
	@runReview {
		method GET POST
		path_regexp runReview ^/api/v1/runs/[1-9][0-9]{0,15}/review$
	}
	handle @runReview {
		request_body {
			max_size 1KB
		}
		reverse_proxy 127.0.0.1:18080
	}
	handle {
		respond 404
	}
}
