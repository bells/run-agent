# Paths are absolute paths on the deployment host. Quote paths with spaces.
RUN_AGENT_MARATHON_SUB3_MANIFEST=/home/deploy/.local/share/run-agent/marathon-sub3-inputs/marathon_sub3_sources.json

# Keep providing the approved PDF when refreshing an imported annual catalog.
# RUN_AGENT_MARATHON_SUB3_CATALOG_PDF=/home/deploy/.local/share/run-agent/marathon-sub3-inputs/caa-2026.pdf

# Set this to use reviewed UTF-8 announcements instead of fetching their registered URLs.
# RUN_AGENT_MARATHON_SUB3_ANNOUNCEMENT_DIR=/home/deploy/.local/share/run-agent/marathon-sub3-inputs/announcements

# Use the same directory as remote-release.sh when overriding its default.
# RUN_AGENT_DEPLOY_DIR=/srv/run-agent

# Optional. Try the registered live website before falling back to archived HTML.
# Set only one of the two announcement directory variables.
# RUN_AGENT_MARATHON_SUB3_ANNOUNCEMENT_FALLBACK_DIR=/absolute/path/to/archives
